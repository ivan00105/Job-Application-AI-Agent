# PostgreSQL Database Configuration
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# API Configuration
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Reverse Proxy Configuration
EXTERNAL_URL=
ALLOWED_ORIGINS=
TRUSTED_PROXY_HOSTS=127.0.0.1
ROOT_PATH=

# Qdrant Configuration
# Use QDRANT_PATH for local file-based storage, or QDRANT_HOST/QDRANT_PORT for server mode
QDRANT_HOST=192.168.0.105
QDRANT_PORT=6333
# QDRANT_PATH=./qdrant_db  # Uncomment to use local file-based storage instead of server

# Ollama Configuration
OLLAMA_BASE_URL=http://192.168.0.131:11434
OLLAMA_EMBEDDING_MODEL=bge-m3

# Embedding Configuration
EMBEDDING_DIM=1024

# Qdrant Collection Name
QDRANT_COLLECTION_NAME=job_data

# Scraping Configuration (Optional - defaults shown)
SCRAPE_SITES=["indeed", "linkedin", "google"]
SCRAPE_RESULTS_WANTED=1000
SCRAPE_HOURS_OLD=720
SAVE_JOBS_CSV=false

# Processing Configuration
BATCH_SIZE=10
ENABLE_DUPLICATE_DETECTION=true

# Openrouter Search Enhancement
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
ENABLE_LLM_QUERY_ENHANCEMENT=true

# LLM Logging Configuration
ENABLE_LLM_LOGGING=false

# Set to True to keep CV HTML and PDF files in data/cv folder
# Set to False (default) to clean up files after use
KEEP_CV_FILES=false

