# PostgreSQL Database
POSTGRES_HOST=pg.groture.com
POSTGRES_PORT=5130
POSTGRES_DB=job_agent
POSTGRES_USER=your_username_here
POSTGRES_PASSWORD=your_password_here

# JobsEngine Service
JOBSENGINE_URL=http://friend-ip-or-domain:8001

# Ollama for LLM
OLLAMA_URL=http://friend-ip-or-domain:11434
OLLAMA_CHAT_MODEL=llama3

# Security
# secret key can be generated like: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_generated_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# External AI APIs (Optional - leave empty for now)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Server
HOST=0.0.0.0
PORT=8000